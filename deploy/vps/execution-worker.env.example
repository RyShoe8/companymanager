# Copy to execution-worker.env on the VPS. Never commit the populated file.
NUCLEAS_EXECUTION_WORKER_TOKEN=replace-with-a-new-random-64-character-token
NUCLEAS_AI_REMOTE_ENDPOINT=https://llm.example.com/v1/chat/completions
NUCLEAS_AI_REMOTE_BEARER_TOKEN=replace-with-the-litellm-credential
# Fallback only. New requests select the coding model in Admin > AI Settings.
NUCLEAS_AI_REMOTE_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ

# Keep this narrow. Add a binary only after installing it in the image and
# reviewing the security impact.
NUCLEAS_EXECUTION_ALLOWED_BINARIES=node,npm,npx,git
